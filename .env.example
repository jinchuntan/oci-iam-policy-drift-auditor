# Copy to .env. These values preserve the application's existing defaults.
# Credentials remain in the OCI SDK config and signing-key files.
# Leave OCI_CONFIG_FILE unset to use your home directory's .oci/config.
# To override it, uncomment this line and use an absolute path:
# OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
# Blank region uses the SDK profile's region.
OCI_REGION=
# Blank root uses the tenancy; set a compartment OCID to narrow the scan.
OCI_ROOT_COMPARTMENT_OCID=
OCI_INCLUDE_SUBCOMPARTMENTS=true
OCI_AUDIT_LOOKBACK_HOURS=24
OCI_OUTPUT_DIR=output

# Blank namespace is resolved from OCI. By default, the tool discovers buckets
# and tries candidates until an upload succeeds. To restrict the destination,
# set OCI_OBJECT_STORAGE_BUCKET and OCI_AUTO_DISCOVER_BUCKET=false together.
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OBJECT_STORAGE_PREFIX=iam-policy-drift-audit
OCI_AUTO_DISCOVER_BUCKET=true
OCI_FAIL_ON_UPLOAD_ERROR=true
